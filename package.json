{
  "name": "dsh-task-delegation-mcp",
  "version": "0.1.0",
  "description": "An MCP server that lets external agents delegate coding tasks to DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.yml": "./cordis.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.yml",
    "README.md",
    "SECURITY.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "check:lib": "npm run build && git diff --exit-code -- lib",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "coding-agent",
    "task-delegation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longskyi/dsh-task-delegation-mcp.git"
  },
  "homepage": "https://github.com/longskyi/dsh-task-delegation-mcp#readme",
  "bugs": {
    "url": "https://github.com/longskyi/dsh-task-delegation-mcp/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
